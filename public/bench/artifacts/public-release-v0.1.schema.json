      "type": "object"
    },
    "TrackType": {
      "description": "Benchmark tracks that must be reported separately.",
      "enum": [
        "controlled_model",
        "end_to_end_system"
      ],
      "title": "TrackType",
      "type": "string"
    },
    "UncertaintyEvidence": {
      "additionalProperties": false,
      "properties": {
        "cer_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cer Interval"
        },
        "confidence_level": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Level"
        },
        "mer_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mer Interval"
        },
        "method": {
          "enum": [
            "not_applicable_contract_fixture",
            "not_computed",
            "paired_bootstrap"
          ],
          "title": "Method",
          "type": "string"
        },
        "paired_significance_artifact_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paired Significance Artifact Uri"
        },
        "wer_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wer Interval"
        }
      },
      "required": [
        "method"
      ],
      "title": "UncertaintyEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Aggregate-only release with separate controlled and end-to-end tables.",
