      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "release_date": {
      "title": "Release Date",
      "type": "string"
    },
    "release_id": {
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "required_baseline_count": {
      "const": 6,
      "title": "Required Baseline Count",
      "type": "integer"
    },
    "source_manifest_sha256": {
      "title": "Source Manifest Sha256",
      "type": "string"
    },
    "suite_id": {
      "const": "sea-broadcast-asr",
      "title": "Suite Id",
      "type": "string"
    },
    "suite_version": {
      "minLength": 1,
      "title": "Suite Version",
      "type": "string"
    }
