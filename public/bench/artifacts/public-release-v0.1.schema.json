  "required": [
    "contract_version",
    "release_id",
    "generated_at",
    "release_date",
    "suite_id",
    "suite_version",
    "evaluation_set_version",
    "source_manifest_sha256",
    "required_baseline_count",
    "baseline_count",
    "controlled_model_table",
    "end_to_end_system_table",
    "contains_item_level_rows",
    "contains_transcripts",
    "contains_references",
    "contains_media_uris",
    "contains_private_test_identifiers",
    "contains_private_failure_history"
  ],
  "title": "PublicBenchmarkRelease",
  "type": "object"
}
