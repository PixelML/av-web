    "PublicMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "cer": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cer"
        },
        "character_edits": {
          "minimum": 0,
          "title": "Character Edits",
          "type": "integer"
        },
        "code_switch_sample_count": {
          "minimum": 0,
          "title": "Code Switch Sample Count",
          "type": "integer"
        },
        "mer": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mer"
        },
        "mixed_errors": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mixed Errors"
