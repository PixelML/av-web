          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mixed Reference Units"
        },
        "reference_characters": {
          "minimum": 0,
          "title": "Reference Characters",
          "type": "integer"
        },
        "reference_words": {
          "minimum": 0,
          "title": "Reference Words",
          "type": "integer"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "wer": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wer"
        },
        "word_edits": {
          "minimum": 0,
          "title": "Word Edits",
          "type": "integer"
        }
